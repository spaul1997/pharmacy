NODE_ENV=production
HOST=0.0.0.0
PORT=5000

MONGODB_URI=mongodb://username:password@host:27017/pharmacy?authSource=admin

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=72h

CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
SERVE_FRONTEND=true

SPECIAL_ADMIN_EMPLOYEE_CODE=SPECIALADMIN
SPECIAL_ADMIN_NAME=Special Admin
SPECIAL_ADMIN_EMAIL=admin@example.com
SPECIAL_ADMIN_MOBILE=9999999999
SPECIAL_ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_bcrypt_hash
